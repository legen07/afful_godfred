{
	"$schema": "node_modules/wrangler/config-schema.json",

	// CI (Pages git build) — set in the dashboard (Settings → Build):
	//   - Build command       : bun install && bun run build
	//   - Build output dir    : out
	//   - Node.js version     : 22 (or newer) — Next 16 requires >= 20.9
	// Your Pages project name — used by `wrangler pages deploy` (local CLI).
	// If the dashboard shows a different name, update it here (or delete this
	// field and pass --project-name <name>).
	"compatibility_date": "2026-09-15",
	"name": "afful-godfred",

	// static build output lives.
	"pages_build_output_dir": "out"
}
